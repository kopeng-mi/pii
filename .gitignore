# Rust
/target
**/*.rs.bk

# Local data — dev uses ./.pii/, release uses $LOCALAPPDATA/pii/ (Win)
# or ~/.local/share/pii/ (Linux) — never in CWD.
.pii/
/pii.db
/pii.db-shm
/pii.db-wal

# Env / secrets
.env
.env.*
!.env.example

# Editor noise
.vscode/
.idea/
*.swp
*.swo
*~

# OS noise
.DS_Store
Thumbs.db

# Test artifacts
/tmp/
